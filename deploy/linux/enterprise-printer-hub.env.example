# 复制为 /etc/enterprise-printer-hub.env 并按实际情况修改
PRINT_HUB_CONVERTER_MODE=gotenberg
PRINT_HUB_GOTENBERG_URL=http://127.0.0.1:3000
PRINT_HUB_GOTENBERG_TIMEOUT=120

# 可选：若启用了 Gotenberg Basic Auth，在此填写
# PRINT_HUB_GOTENBERG_USER=
# PRINT_HUB_GOTENBERG_PASSWORD=

# 可选：访问与管理口令（留空则内网免密）
# PRINT_HUB_API_TOKEN=
# PRINT_HUB_ADMIN_TOKEN=

# 允许中心后台访问者添加打印机。填写浏览器访问的完整来源，不含路径。
PRINT_HUB_REGISTRATION_ORIGIN=https://10.0.249.200:8086
