log_format print_hub_office_native '$status $request_time';

server {
    # Replace the example IP, name and certificate paths before enabling.
    listen 192.0.2.10:443 ssl;
    server_name converter.example.internal;
    ssl_certificate /etc/nginx/tls/print-hub-office-fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/print-hub-office.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    location = /office-converter/forms/libreoffice/convert {
        limit_except POST { deny all; }
        auth_basic "Print Hub Office conversion";
        auth_basic_user_file /etc/nginx/print-hub-office.htpasswd;
        client_max_body_size 26215424;
        client_body_timeout 15s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 15s;
        proxy_read_timeout 100s;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_pass_request_headers off;
        proxy_set_header Content-Type $content_type;
        proxy_pass http://unix:/run/print-hub-office.sock;
        access_log /var/log/nginx/print-hub-office.log print_hub_office_native;
    }

    location / { return 404; }
}
