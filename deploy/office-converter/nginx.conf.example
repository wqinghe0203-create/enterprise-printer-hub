# In the http context:
# log_format print_hub_conversion '$status $request_time';

# In the existing private HTTPS server block:
location = /office-converter/forms/libreoffice/convert {
    limit_except POST { deny all; }
    client_max_body_size 26214656;
    client_body_timeout 15s;
    proxy_connect_timeout 5s;
    proxy_send_timeout 15s;
    proxy_read_timeout 100s;
    proxy_http_version 1.1;
    proxy_request_buffering off;
    proxy_buffering off;
    proxy_pass_request_headers off;
    proxy_set_header Authorization $http_authorization;
    proxy_set_header Content-Type $content_type;
    proxy_pass http://127.0.0.1:13000/forms/libreoffice/convert;
    access_log /var/log/nginx/print-hub-conversion.log print_hub_conversion;
}
